---
// Rounded card with subtle border and hover lift. When `href` is set the
// whole card becomes a link; do not nest links or buttons inside it then.
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const classes = [
  "block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 motion-reduce:transition-none hover:-translate-y-1 hover:shadow-md motion-reduce:hover:translate-y-0",
  href && "hover:border-brand-200",
  className,
];
---

{href ? <a href={href} class:list={classes}><slot /></a> : <div class:list={classes}><slot /></div>}
