---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { contact } from "../config/site";

// Embedded Google Map query carried over verbatim from the legacy site
// (docs/legacy-content/contacto.md).
const MAP_EMBED_URL =
  "https://maps.google.com/maps?f=q&source=s_q&hl=es&q=Av.%20Amazonas%20N26-179%20y%20Av.%20Orellana&aq=0&ie=UTF8&t=m&z=16&iwloc=A&output=embed";

const description =
  "Escríbanos o visítenos: dirección, teléfonos y formulario de contacto de ENDE Cía. Ltda., inspección con ensayos no destructivos en Quito, Ecuador.";

const breadcrumb = [{ label: "Inicio", href: "/" }, { label: "Contacto" }];

const cardClass = "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm";
const linkClass = "font-semibold text-brand-700 hover:text-brand-800";
---

<BaseLayout title="Contacto" description={description} breadcrumb={breadcrumb}>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de su próximo proyecto"
    lead="Contáctenos para cotizaciones, consultas técnicas o cualquier información sobre nuestros servicios de ensayos no destructivos."
    breadcrumb={breadcrumb}
  />

  <Section>
    <Container>
      <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-12">
        <!-- Contact information -->
        <div class="space-y-6">
          <div class={cardClass}>
            <div class="flex items-start gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mt-0.5 size-6 shrink-0 text-brand-700"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                ></path>
              </svg>
              <div>
                <h2 class="font-bold text-ink">Dirección</h2>
                <p class="mt-1 leading-7 text-muted">
                  {contact.addressLines[0]}<br />
                  {contact.addressLines[1]}<br />
                  {contact.city}, {contact.country}
                </p>
              </div>
            </div>
          </div>

          <div class={cardClass}>
            <div class="flex items-start gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mt-0.5 size-6 shrink-0 text-brand-700"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                ></path>
              </svg>
              <div>
                <h2 class="font-bold text-ink">Teléfonos</h2>
                <ul class="mt-1 list-none space-y-1 p-0 leading-7">
                  {
                    contact.phones.map((phone) => (
                      <li>
                        <a href={`tel:${phone.tel}`} class={linkClass}>
                          {phone.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="mt-3 text-sm leading-6 text-muted">
                  Quejas y reclamos:
                  <a
                    href={`tel:${contact.complaintsPhone.tel}`}
                    class={linkClass}
                  >
                    {contact.complaintsPhone.label}
                  </a>
                </p>
              </div>
            </div>
          </div>

          <div class={cardClass}>
            <div class="flex items-start gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mt-0.5 size-6 shrink-0 text-brand-700"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                ></path>
              </svg>
              <div>
                <h2 class="font-bold text-ink">Correo electrónico</h2>
                <p class="mt-1">
                  <a href={`mailto:${contact.email}`} class={linkClass}>
                    {contact.email}
                  </a>
                </p>
              </div>
            </div>
          </div>

          <div class={cardClass}>
            <div class="flex items-start gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="mt-0.5 size-6 shrink-0 text-brand-700"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
                ></path>
              </svg>
              <div>
                <h2 class="font-bold text-ink">Quejas y apelaciones</h2>
                <p class="mt-1 text-sm leading-6 text-muted">
                  Si desea presentar un reclamo, consulte el procedimiento de
                  quejas y apelaciones (P-MJC-05) y el formato de recepción
                  correspondiente en nuestra página de sistemas de gestión.
                </p>
                <a href="/sistemas-de-gestion/" class={`mt-2 inline-block ${linkClass}`}>
                  Ver procedimiento de quejas y apelaciones
                </a>
              </div>
            </div>
          </div>

          <div class={cardClass}>
            <div class="flex items-start gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="mt-0.5 size-6 shrink-0 text-brand-700"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M13.5 21v-7.5h2.52l.48-3h-3V8.55c0-.87.24-1.8 1.92-1.8H16.8V4.14c-.3-.04-1.35-.14-2.55-.14-2.52 0-4.25 1.54-4.25 4.36v2.14H7.5v3h2.5V21h3.5Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <div>
                <h2 class="font-bold text-ink">Facebook</h2>
                <p class="mt-1">
                  <a
                    href={contact.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                  >
                    Síganos en Facebook
                  </a>
                </p>
              </div>
            </div>
          </div>

          <iframe
            title="Ubicación de ENDE Cía. Ltda. en Google Maps"
            src={MAP_EMBED_URL}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="aspect-[4/3] w-full rounded-2xl border border-slate-200 bg-surface shadow-sm"
          >
          </iframe>
        </div>

        <!-- Contact form -->
        <ContactForm />
      </div>
    </Container>
  </Section>
</BaseLayout>
