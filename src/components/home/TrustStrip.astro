---
// Trust strip: four business facts taken verbatim from the legacy site
// (see docs/legacy-content/business-data.md). No invented numbers.
const stats = [
  {
    value: "Desde 1990",
    label: "Ensayos no destructivos del Ecuador",
  },
  {
    value: "SAE-ACR-0124-2021",
    label: "Organismo de inspección acreditado ante el SAE",
  },
  {
    value: "ASNT Nivel III y AWS-CWI",
    label: "Personal certificado",
  },
  {
    value: "5 técnicas END",
    label: "Y servicios complementarios",
  },
];
---

<section class="border-y border-slate-100 bg-surface">
  <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <ul class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <li>
            <p class="text-xl font-bold tracking-tight text-brand-800">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-muted">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
