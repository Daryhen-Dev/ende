---
// Download link row for a public document, showing its file type and size.
interface Props {
  href: string;
  title: string;
  meta: string;
  class?: string;
}
const { href, title, meta, class: className } = Astro.props;
---

<a
  href={href}
  download
  class:list={[
    "group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 transition-colors motion-reduce:transition-none hover:border-brand-300",
    className,
  ]}
>
  <span
    class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="size-5"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m6.75 12-3-3m0 0-3 3m3-3v6m-1.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
      ></path>
    </svg>
  </span>
  <span class="flex-1">
    <span class="block font-semibold text-ink group-hover:text-brand-800"
      >{title}</span
    >
    <span class="block text-sm text-muted">{meta}</span>
  </span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class="size-5 shrink-0 text-brand-700 transition-transform motion-safe:group-hover:translate-y-0.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
    ></path>
  </svg>
</a>
