---
// Home page: hero, trust strip, services, sectors, quality, memberships and
// CTA band. Content is based on the legacy site (docs/legacy-content/).
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import ServiceCard from "../components/services/ServiceCard.astro";
import Hero from "../components/home/Hero.astro";
import TrustStrip from "../components/home/TrustStrip.astro";
import SectorGrid from "../components/home/SectorGrid.astro";
import QualitySection from "../components/home/QualitySection.astro";
import Memberships from "../components/home/Memberships.astro";
import CtaBand from "../components/home/CtaBand.astro";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
---

<BaseLayout
  title="ENDE Cía. Ltda. | Ensayos No Destructivos del Ecuador"
  description="Organismo de inspección acreditado ante el SAE e ISO 9001:2015. Ensayos no destructivos en Ecuador desde 1990: RT, UT, PM, PT y más."
>
  <Hero />
  <TrustStrip />

  <Section>
    <Container>
      <SectionHeading
        eyebrow="Servicios"
        title="Técnicas de ensayos no destructivos"
        lead="Inspección de soldaduras, tuberías, tanques y estructuras según estándares API, ASME, AWS y AWWA."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <ServiceCard service={service} headingLevel={3} />
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <Button href="/servicios" variant="ghost" arrow>
          Ver todos los servicios
        </Button>
      </div>
    </Container>
  </Section>

  <SectorGrid />
  <QualitySection />
  <Memberships />
  <CtaBand />
</BaseLayout>
