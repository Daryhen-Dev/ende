---
// Highlight card for institutional pillars (mission, vision, policy) with an
// icon slot so each page supplies its own inline SVG.
interface Props {
  title: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<div
  class:list={[
    "flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm",
    className,
  ]}
>
  <div
    class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
  >
    <slot name="icon" />
  </div>
  <h3 class="mt-4 text-xl font-bold text-ink">{title}</h3>
  <div class="mt-3 leading-7 text-muted">
    <slot />
  </div>
</div>
