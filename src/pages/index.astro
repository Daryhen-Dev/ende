---
// Temporary scaffold page; replaced by the real home in task 4.
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-ende.png";
import { site } from "../config/site";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{site.name} | {site.tagline}</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-surface">
    <main class="text-center">
      <Image src={logo} alt={site.name} class="mx-auto h-24 w-auto" loading="eager" />
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-brand-900">{site.tagline}</h1>
      <p class="mt-3 text-muted">Nuevo sitio en construcción.</p>
      <div class="mt-6 flex justify-center gap-2" aria-hidden="true">
        <span class="size-6 rounded-full bg-brand-500"></span>
        <span class="size-6 rounded-full bg-brand-700"></span>
        <span class="size-6 rounded-full bg-brand-900"></span>
      </div>
    </main>
  </body>
</html>
