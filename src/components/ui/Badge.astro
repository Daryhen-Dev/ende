---
// Pill badge for labels and tags.
interface Props {
  tone?: "brand" | "neutral";
  class?: string;
}
const { tone = "brand", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold",
    tone === "brand" ? "bg-brand-50 text-brand-800" : "bg-slate-100 text-slate-700",
    className,
  ]}
>
  <slot />
</span>
