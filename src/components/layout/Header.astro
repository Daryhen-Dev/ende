---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import { site, nav } from "../../config/site";
import logo from "../../assets/brand/logo-ende.png";

// Normalize trailing slash so /servicios/ matches /servicios.
const path =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center" aria-label={`${site.name} — Inicio`}>
      <Image src={logo} alt={site.name} class="h-11 w-auto" loading="eager" />
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-full px-3 py-2 text-sm font-medium transition-colors",
                  isActive(item.href)
                    ? "bg-brand-50 text-brand-800"
                    : "text-ink hover:bg-slate-100 hover:text-brand-800",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <Button href="/contacto" size="md">Solicitar cotización</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex items-center justify-center rounded-full p-2 text-ink hover:bg-slate-100 lg:hidden"
    >
      <span class="sr-only label-open">Abrir menú</span>
      <span class="sr-only hidden label-close">Cerrar menú</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-6 icon-open"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="hidden size-6 icon-close"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-slate-200 bg-white lg:hidden">
    <nav aria-label="Navegación móvil">
      <ul class="space-y-1 px-4 py-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-lg px-3 py-2 text-base font-medium",
                  isActive(item.href)
                    ? "bg-brand-50 text-brand-800"
                    : "text-ink hover:bg-slate-100",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <Button href="/contacto" size="md">Solicitar cotización</Button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  #menu-toggle[aria-expanded="true"] :global(.icon-open),
  #menu-toggle[aria-expanded="true"] :global(.label-open) {
    display: none;
  }
  #menu-toggle[aria-expanded="true"] :global(.icon-close),
  #menu-toggle[aria-expanded="true"] :global(.label-close) {
    display: block;
  }
</style>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };
    toggle.addEventListener("click", () => setOpen(!menu.hidden));
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
  }

  // Close with Escape from anywhere on the page.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (toggle && menu && !menu.hidden) {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.focus();
    }
  });

  // astro:page-load fires on first load and after every view-transition
  // navigation, so listeners re-bind to the fresh DOM each time.
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
