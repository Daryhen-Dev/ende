---
// Inner-page hero with subtle gradient and decorative blurred brand circles.
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumb?: Crumb[];
}
const { eyebrow, title, lead, breadcrumb } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute -top-24 right-0 size-72 rounded-full bg-brand-200/40 blur-3xl"
    >
    </div>
    <div
      class="absolute -left-20 top-16 size-80 rounded-full bg-brand-100/60 blur-3xl"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    {
      breadcrumb && (
        <nav aria-label="Ruta" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
            {breadcrumb.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-brand-700">
                    {crumb.label}
                  </a>
                ) : (
                  <span aria-current="page" class="font-medium text-ink">
                    {crumb.label}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {
      eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-muted">{lead}</p>}
    <slot />
  </div>
</section>
