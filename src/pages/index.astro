---
// Temporary demo page to preview the design system; the real home is built
// in a later task.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";

const demoServices = [
  {
    badge: "RT",
    title: "Radiografía industrial",
    text: "Detección de discontinuidades internas en soldaduras, tuberías y recipientes a presión.",
  },
  {
    badge: "UT",
    title: "Ultrasonido",
    text: "Medición de espesores y evaluación de integridad en componentes metálicos.",
  },
  {
    badge: "PM",
    title: "Partículas magnéticas",
    text: "Inspección de discontinuidades superficiales y sub superficiales en materiales ferromagnéticos.",
  },
];
---

<BaseLayout
  title="ENDE Cía. Ltda. | Ensayos No Destructivos del Ecuador"
  description="ENDE Cía. Ltda. es una empresa que se dedica a realizar ensayos no destructivos."
>
  <PageHero
    eyebrow="Ensayos no destructivos"
    title="Integridad y confianza para su infraestructura"
    lead="Más de 30 años inspeccionando oleoductos, tanques, refinerías y estructuras en Ecuador con estándares internacionales."
    breadcrumb={[
      { label: "Inicio", href: "/" },
      { label: "Vista de demostración" },
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/contacto" size="lg">Solicitar cotización</Button>
      <Button href="/servicios" size="lg" variant="secondary">Ver servicios</Button>
    </div>
  </PageHero>

  <Section variant="surface">
    <Container>
      <SectionHeading
        eyebrow="Servicios"
        title="Técnicas de inspección"
        lead="Vista de demostración del sistema de diseño: tarjetas, badges y botones sobre fondo surface."
        align="center"
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          demoServices.map((service) => (
            <Card>
              <Badge>{service.badge}</Badge>
              <h3 class="mt-4 text-lg font-semibold text-ink">{service.title}</h3>
              <p class="mt-2 text-sm text-muted">{service.text}</p>
              <Button href="/servicios" variant="ghost" arrow class="mt-4">
                Conocer más
              </Button>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section variant="dark">
    <Container>
      <SectionHeading
        eyebrow="Contacto"
        title="¿Necesita una inspección?"
        lead="Nuestro equipo le responderá a la brevedad."
        align="center"
        tone="dark"
      />
      <div class="mt-8 flex justify-center">
        <Button href="/contacto" variant="light" size="lg">Contáctenos</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
