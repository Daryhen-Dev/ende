---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site, nav, contact, certifications, memberships } from "../../config/site";
import logo from "../../assets/brand/logo-ende.png";
import asme from "../../assets/brand/asme.png";
import asnt from "../../assets/brand/asnt.png";
import aws from "../../assets/brand/aws.png";
import api from "../../assets/brand/api.png";

const year = new Date().getFullYear();
const membershipLogos: Record<string, ImageMetadata> = { ASME: asme, ASNT: asnt, AWS: aws, API: api };
---

<footer class="bg-brand-950 text-brand-100">
  <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <span class="inline-block rounded-xl bg-white px-4 py-2">
          <Image src={logo} alt={site.name} class="h-10 w-auto" loading="lazy" />
        </span>
        <p class="mt-4 text-sm leading-relaxed">
          {site.tagline}. Inspección y ensayos no destructivos con confianza
          desde 1990.
        </p>
        <h2 class="mt-8 text-sm font-semibold uppercase tracking-widest text-white">
          Certificaciones
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            certifications.map((cert) => (
              <li>
                <span class="font-semibold text-white">{cert.name}</span>
                <span class="block text-brand-200">{cert.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-white">
          Navegación
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="text-brand-200">
            Factura electrónica
            <span class="block text-xs">(portal temporalmente no disponible)</span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-white">
          Contacto
        </h2>
        <address class="mt-3 space-y-2 text-sm not-italic">
          <p>
            {
              contact.addressLines.map((line) => (
                <span class="block">{line}</span>
              ))
            }
            <span class="block">{contact.city}, {contact.country}</span>
          </p>
          <p>
            {
              contact.phones.map((phone) => (
                <a href={`tel:${phone.tel}`} class="block hover:text-white">
                  {phone.label}
                </a>
              ))
            }
            <span class="mt-1 block text-xs text-brand-200">
              Quejas y reclamos:
              <a href={`tel:${contact.complaintsPhone.tel}`} class="hover:text-white">
                {contact.complaintsPhone.label}
              </a>
            </span>
          </p>
          <p>
            <a href={`mailto:${contact.email}`} class="hover:text-white">
              {contact.email}
            </a>
          </p>
          <p>
            <a
              href={contact.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white"
            >
              Facebook
            </a>
          </p>
        </address>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-white">
          Membresías
        </h2>
        <ul class="mt-3 flex flex-wrap gap-3">
          {
            memberships.map((membership) => (
              <li>
                <a
                  href={membership.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block rounded-lg bg-white px-3 py-2 transition-opacity hover:opacity-85"
                  aria-label={membership.name}
                >
                  <Image
                    src={membershipLogos[membership.name]}
                    alt={membership.name}
                    class="h-7 w-auto"
                    loading="lazy"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto w-full max-w-7xl px-4 py-5 text-center text-sm text-brand-200 sm:px-6 lg:px-8">
      © {year} {site.name} Todos los derechos reservados.
    </div>
  </div>
</footer>
